{
  "project": "LlamaChat",
  "version": "v0.1",
  "author": "Mikko Hilpinen",
  "package": "vf.llama.view.component",
  "packages": {
    "flow": "utopia.flow",
    "genesis": "utopia.genesis",
    "pointers": "flow/view.template.eventful",
    "fixed": "flow/view.immutable.eventful"
  },
  "references": {
    "flag": "pointers/Flag",
    "TRUE": "fixed/AlwaysTrue",
    "FALSE": "fixed/AlwaysFalse"
  },
  "components": {
    "messaging": [
      {
        "name": "SendMessageView",
        "context": "text.static",
        "onlyContextual": true,
        "props": [
          {
            "name": "inputWidth",
            "param": "width",
            "type": "Double",
            "default": {
              "refs": ["genesis/util.Screen"],
              "code": "Screen.width * 0.3"
            },
            "doc": "Default width of the message input field",
            "mapping": true
          },
          {
            "name": "enabledFlag",
            "param": "flag",
            "type": "flag",
            "default": {
              "refs": ["TRUE"],
              "code": "AlwaysTrue"
            },
            "doc": "A flag that determines when the send button is enabled",
            "mapping": true
          }
        ]
      }
    ]
  },
  "components_example": {
    "subpackage1": {
      "subpackage2.subPackage3": [
        {
          "name": "ComponentName",
          "name_plural": "PluralComponentName",
          "context": "base | color | text | window (optional)",
          "parents": ["framed and/or customDrawable and/or focus"],
          "props": [
            {
              "name": "prop1",
              "name_plural": "manyProp1s (optional)",
              "type": "refAlias1 (optional for references)",
              "ref": "OtherComponentName (optional)",
              "prefix": "(optional)",
              "prefix_properties": true,
              "setter": "withProp1 (optional)",
              "param": "prop1 (optional)",
              "default": {
                "references": ["com.company.project.model.DataType3", "refAlias2"],
                "code": "DataType3.default"
              },
              "doc": "Description of property function (optional)",
              "mapping": false
            }
          ],
          "non_contextual_props": [],
          "contextual_props": [],
          "only_contextual": false,
          "variable_context": false
        }
      ]
    }
  }
}